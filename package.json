{
  "name": "portifolio-alan",
  "version": "1.0.0",
  "description": "Portfólio minimalista e editorial de edição de vídeo, motion e direção criativa, com player cinema integrado (lightbox) para vídeos do YouTube e pronto para publicação no **GitHub Pages**.",
  "main": "projects.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:legacy": "node scripts/test-portfolio.js",
    "server": "node scripts/server.js",
    "dev:all": "node -e \"const { spawn } = require('child_process'); spawn('node', ['scripts/server.js'], { stdio: 'inherit' }); spawn('npx', ['vite'], { stdio: 'inherit', shell: true });\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alanosantoss/portfolio.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/alanosantoss/portfolio/issues"
  },
  "homepage": "https://github.com/alanosantoss/portfolio#readme",
  "dependencies": {
    "gsap": "^3.15.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.11",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
